# SPDX-License-Identifier: MIT
# Apache Kafka 4.4.0, the latest release (checked against Apache's published SHA-512), as
# examples/kafka/Dockerfile builds 3.8.0: KRaft brokers, and the client node, KClient.java
# compiled against this distribution's kafka-clients (4.4.0: transactions v2, KIP-890, which the
# brokers enable from 4.0). The `kafka-4.4` profile: bugs found in 3.8.0 may be fixed here
# (KAFKA-18137, in 4.0.0), and new ones are found in a current release.
FROM docker.io/library/debian:bookworm-slim AS build
ARG KAFKA_SHA512=f5ceba8a265ab6bb2d68362b1f6859a95e15d60ef92ba83b43fdf065b557dc18e98d6383c15b9977320e25b3a2c8b6f11decb17b0fa6c0f163423793a0eb95cb
RUN apt-get update -q \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
      openjdk-17-jdk-headless ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/kafka.tgz https://archive.apache.org/dist/kafka/4.4.0/kafka_2.13-4.4.0.tgz \
 && echo "${KAFKA_SHA512}  /tmp/kafka.tgz" | sha512sum -c - \
 && mkdir /opt/kafka && tar -xzf /tmp/kafka.tgz -C /opt/kafka --strip-components=1 \
 && rm /tmp/kafka.tgz
COPY examples/kafka/KClient.java /opt/kclient/KClient.java
RUN javac -cp "/opt/kafka/libs/*" -d /opt/kclient /opt/kclient/KClient.java

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update -q \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends openjdk-17-jre-headless \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/kafka /opt/kafka
COPY --from=build /opt/kclient /opt/kclient
COPY examples/kafka/start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh && mkdir -p /data
ENTRYPOINT ["/usr/local/bin/start.sh"]
