# SPDX-License-Identifier: MIT
# Kafka 3.8.0 as examples/kafka/Dockerfile builds it, on a Java 25 runtime with determinismo's
# coverage agent (sdk/java/DeterminismoCoverage, built on the JDK's class-file API: Java 24 or
# later): the brokers report the source lines of their coordinators, replication and log as they
# first run them (the `coverage` profile, start.sh's fifth argument).
FROM docker.io/library/debian:bookworm-slim AS build
ARG KAFKA_SHA512=0a33b7be7b6fa53249ba80f9d02cda71ed81927c160aa6ee9be1e3d3c1c4b50466ffc905293143fd88ceac7f5e7d8f5bec28ef972addd3c459cc8b1291e738aa
RUN apt-get update -q \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
      openjdk-17-jdk-headless ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/kafka.tgz https://archive.apache.org/dist/kafka/3.8.0/kafka_2.13-3.8.0.tgz \
 && echo "${KAFKA_SHA512}  /tmp/kafka.tgz" | sha512sum -c - \
 && mkdir /opt/kafka && tar -xzf /tmp/kafka.tgz -C /opt/kafka --strip-components=1 \
 && rm /tmp/kafka.tgz
COPY examples/kafka/KClient.java /opt/kclient/KClient.java
RUN javac -cp "/opt/kafka/libs/*" -d /opt/kclient /opt/kclient/KClient.java

FROM docker.io/library/eclipse-temurin:25-jdk AS agent
COPY sdk/java/Determinismo.java sdk/java/DeterminismoCoverage.java /sdk/
RUN javac -d /sdk/classes /sdk/Determinismo.java /sdk/DeterminismoCoverage.java \
 && printf 'Premain-Class: DeterminismoCoverage\n' > /sdk/manifest \
 && jar cfm /sdk/determinismo-coverage.jar /sdk/manifest -C /sdk/classes .

FROM docker.io/library/eclipse-temurin:25-jre
COPY --from=build /opt/kafka /opt/kafka
COPY --from=build /opt/kclient /opt/kclient
COPY --from=agent /sdk/determinismo-coverage.jar /opt/det/determinismo-coverage.jar
COPY examples/kafka/start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh && mkdir -p /data
ENTRYPOINT ["/usr/local/bin/start.sh"]
