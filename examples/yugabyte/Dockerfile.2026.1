# YugabyteDB 2026.1.2.0-b137, the latest release (the `current` profile), its master and tablet
# server started by start.sh as 1.3.1's are, with more memory.
FROM docker.io/yugabytedb/yugabyte:2026.1.2.0-b137
COPY examples/yugabyte/start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh
ENTRYPOINT ["/usr/local/bin/start.sh"]
