# SPDX-License-Identifier: MIT
# etcd v3.4.3, the version of Jepsen's analysis (2020), checked against its SHA256SUMS.
FROM docker.io/library/alpine:3.20
ARG ETCD_VERSION=v3.4.3
ARG ETCD_SHA256=6c642b723a86941b99753dff6c00b26d3b033209b15ee33325dc8e7f4cd68f07
RUN wget -q -O /tmp/etcd.tar.gz \
      "https://github.com/etcd-io/etcd/releases/download/${ETCD_VERSION}/etcd-${ETCD_VERSION}-linux-amd64.tar.gz" \
 && echo "${ETCD_SHA256}  /tmp/etcd.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/etcd.tar.gz -C /tmp \
 && mv "/tmp/etcd-${ETCD_VERSION}-linux-amd64/etcd" "/tmp/etcd-${ETCD_VERSION}-linux-amd64/etcdctl" \
      /usr/local/bin/ \
 && rm -rf /tmp/etcd*
ENTRYPOINT ["/usr/local/bin/etcd"]
