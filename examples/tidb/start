#!/bin/sh
# A TiDB node as Jepsen's test runs them: PD, TiKV and TiDB together, each started again when it
# exits (Jepsen's restart loops), with Jepsen's configurations. $TIDB_NODE: n1, n2 or n3.
node="$TIDB_NODE"
data=/var/lib/tidb
mkdir -p "$data"
endpoints=n1:2379,n2:2379,n3:2379
again() {
  while true; do
    "$@"
    echo "tidb-start: $1 exited with $?; starting it again" >&2
    sleep 1
  done
}
again /pd-server --name="pd-$node" --data-dir="$data/pd" --config=/etc/tidb/pd.toml \
  --client-urls=http://0.0.0.0:2379 --peer-urls=http://0.0.0.0:2380 \
  --advertise-client-urls="http://$node:2379" --advertise-peer-urls="http://$node:2380" \
  --initial-cluster=pd-n1=http://n1:2380,pd-n2=http://n2:2380,pd-n3=http://n3:2380 &
again /tikv-server --pd="$endpoints" --addr=0.0.0.0:20160 --advertise-addr="$node:20160" \
  --data-dir="$data/tikv" --config=/etc/tidb/tikv.toml &
again /tidb-server --store=tikv --path="$endpoints" --config=/etc/tidb/tidb.toml &
wait
