+// determinismo: an exception out of a command is an internal error (Quint reports a
+// specification's errors itself, as values, with exit code 1).
+function internalError(error: unknown): void {
+  const err = error as { message?: unknown; stack?: unknown }
+  det.unreachable('quint never fails with an internal error', {
+    error: String(err?.message ?? error),
+    stack: String(err?.stack ?? '').slice(0, 2000),
+  })
+}
+process.on('uncaughtException', (error) => {
+  internalError(error)
+  throw error
+})
+process.on('unhandledRejection', (error) => {
+  internalError(error)
+  throw error
+})
+
+main().catch((error) => {
+  internalError(error)
+  process.exitCode = 2
+  console.error(error)
+})
