+/*
+ * determinismo: deterministic execution for single-vCPU VMs.
+ *
+ * A pinned, guest-only PMU counter of retired conditional branches is the clock. RDTSC returns
+ * tsc_base + branches * tsc_per_branch. KVM_DET_SET_TARGET makes the vCPU exit to userspace
+ * exactly when the count reaches the target: the counter overflows `margin` branches early
+ * (PMIs skid), then the Monitor Trap Flag single-steps to the exact count.
+ */
+/*
+ * The hot path (every RDTSC exit and single-step): the counter is pinned to this task, so while
+ * it is active on this CPU, refresh it from the hardware counter and read it, as
+ * perf_event_read_local() does (which modules cannot call). Otherwise, the general read.
+ */
+static u64 vmx_det_branches(struct vcpu_vmx *vmx)
+{
+	struct perf_event *event = vmx->det.counter;
+	unsigned long flags;
+	u64 enabled, running, value;
+
+	local_irq_save(flags);
+	if (READ_ONCE(event->state) == PERF_EVENT_STATE_ACTIVE &&
+	    READ_ONCE(event->oncpu) == smp_processor_id()) {
+		event->pmu->read(event);
+		value = local64_read(&event->count);
+		local_irq_restore(flags);
+		return value;
+	}
+	local_irq_restore(flags);
+	return perf_event_read_value(event, &enabled, &running);
+}
+
+static u64 vmx_det_tsc(struct vcpu_vmx *vmx, u64 branches)
+{
+	return vmx->det.tsc_base + branches * vmx->det.tsc_per_branch;
+}
+
+static void vmx_det_overflow(struct perf_event *event, struct perf_sample_data *data,
+			     struct pt_regs *regs)
+{
+	struct vcpu_vmx *vmx = event->overflow_handler_context;
+
+	WRITE_ONCE(vmx->det.overflowed, true);
+	vmx->det.overflows++;
+}
+
+static void vmx_det_set_stepping(struct vcpu_vmx *vmx, bool on)
+{
+	preempt_disable();
+	if (on)
+		exec_controls_setbit(vmx, CPU_BASED_MONITOR_TRAP_FLAG);
+	else
+		exec_controls_clearbit(vmx, CPU_BASED_MONITOR_TRAP_FLAG);
+	preempt_enable();
+	vmx->det.stepping = on;
+}
+
+/* Disarms the target; returns 0 so the caller exits to userspace. */
+static int vmx_det_reached(struct kvm_vcpu *vcpu, u64 now)
+{
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+
+	if (now > vmx->det.target)
+		vmx->det.overshoots++;
+	vmx->det.reached = now;
+	vmx->det.target = 0;
+	vmx_det_set_stepping(vmx, false);
+	perf_event_period(vmx->det.counter, 1ULL << 62);
+	vcpu->run->exit_reason = KVM_EXIT_DET_TARGET;
+	return 0;
+}
+
+static int vmx_det_arm(struct kvm_vcpu *vcpu, u64 target)
+{
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+	u64 now = vmx_det_branches(vmx);
+
+	if (!target) {
+		vmx->det.target = 0;
+		vmx_det_set_stepping(vmx, false);
+		return perf_event_period(vmx->det.counter, 1ULL << 62);
+	}
+	if (target <= now)
+		return -ERANGE;
+	vmx->det.target = target;
+	WRITE_ONCE(vmx->det.overflowed, false);
+	if (target - now <= vmx->det.margin) {
+		vmx_det_set_stepping(vmx, true);
+		return 0;
+	}
+	vmx_det_set_stepping(vmx, false);
+	vmx->det.overflow_point = target - vmx->det.margin;
+	return perf_event_period(vmx->det.counter, target - now - vmx->det.margin);
+}
+
+/* Runs after every exit, preemptible: turns a counter overflow into single-stepping. */
+static int vmx_det_after_exit(struct kvm_vcpu *vcpu, int ret)
+{
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+	u64 now;
+
+	/* Perf could not schedule the pinned counter (the PMU's counters all taken): no clock. */
+	if (unlikely(READ_ONCE(vmx->det.counter->state) == PERF_EVENT_STATE_ERROR))
+		return -EBUSY;
+	if (!vmx->det.target || vmx->det.stepping || !READ_ONCE(vmx->det.overflowed))
+		return ret;
+	WRITE_ONCE(vmx->det.overflowed, false);
+	now = vmx_det_branches(vmx);
+	if (now > vmx->det.overflow_point && now - vmx->det.overflow_point > vmx->det.skid_max)
+		vmx->det.skid_max = now - vmx->det.overflow_point;
+	if (now >= vmx->det.target)
+		return ret > 0 ? vmx_det_reached(vcpu, now) : ret;
+	vmx_det_set_stepping(vmx, true);
+	return ret;
+}
+
+/*
+ * Single-steps short of the target are the hot path of exact stops: count them and re-enter
+ * the guest from the fastpath (interrupts still off). The step that reaches the target goes
+ * through handle_monitor_trap(), which exits to userspace.
+ */
+static fastpath_t vmx_det_fastpath_step(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+
+	if (!vmx->det.stepping || !vmx->det.target)
+		return EXIT_FASTPATH_NONE;
+	if (vmx_det_branches(vmx) >= vmx->det.target)
+		return EXIT_FASTPATH_NONE;
+	vmx->det.mtf_steps++;
+	vmx->det.fast_steps++;
+	return EXIT_FASTPATH_REENTER_GUEST;
+}
+
 static int handle_monitor_trap(struct kvm_vcpu *vcpu)
 {
-	return 1;
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+	u64 now;
+
+	if (!vmx->det.stepping)
+		return 1;
+	vmx->det.mtf_steps++;
+	now = vmx_det_branches(vmx);
+	if (now < vmx->det.target)
+		return 1;
+	return vmx_det_reached(vcpu, now);
+}
+
+static int handle_rdtsc(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+	u64 tsc;
+
+	if (!vmx->det.counter)
+		return kvm_handle_invalid_op(vcpu);
+	vmx->det.rdtsc_exits++;
+	tsc = vmx_det_tsc(vmx, vmx_det_branches(vmx));
+	kvm_rax_write(vcpu, (u32)tsc);
+	kvm_rdx_write(vcpu, tsc >> 32);
+	if (!vmx->det.soft_tsc || tsc < vmx->det.soft_tsc)
+		return kvm_skip_emulated_instruction(vcpu);
+	/*
+	 * A soft deadline passed: exit to userspace right after this RDTSC, a point as exact as a
+	 * branch-count stop but free (no single-stepping). The hard target stays armed.
+	 */
+	vmx->det.soft_tsc = 0;
+	vmx->det.soft_exits++;
+	kvm_skip_emulated_instruction(vcpu);
+	vcpu->run->exit_reason = KVM_EXIT_DET_TARGET;
+	return 0;
+}
+
+static int vmx_det_enable(struct kvm_vcpu *vcpu, struct kvm_det_config *cfg)
+{
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+	struct perf_event_attr attr = {
+		.type = PERF_TYPE_RAW,
+		.size = sizeof(attr),
+		.config = cfg->event,
+		.pinned = 1,
+		.exclude_host = 1,
+		.sample_period = 1ULL << 62,
+	};
+	struct perf_event *counter;
+
+	if (vmx->det.counter || !cfg->tsc_per_branch || !cfg->margin || cfg->flags)
+		return -EINVAL;
+	counter = perf_event_create_kernel_counter(&attr, -1, current, vmx_det_overflow, vmx);
+	if (IS_ERR(counter))
+		return PTR_ERR(counter);
+	if (READ_ONCE(counter->state) == PERF_EVENT_STATE_ERROR) { /* No PMU counter left for it. */
+		perf_event_release_kernel(counter);
+		return -EBUSY;
+	}
+	vmx->det.counter = counter;
+	vmx->det.tsc_base = cfg->tsc_base;
+	vmx->det.tsc_per_branch = cfg->tsc_per_branch;
+	vmx->det.margin = cfg->margin;
+	preempt_disable();
+	exec_controls_setbit(vmx, CPU_BASED_RDTSC_EXITING);
+	preempt_enable();
+	vcpu->arch.det_enabled = true;
+	return 0;
+}
+
+long vmx_det_ioctl(struct kvm_vcpu *vcpu, unsigned int ioctl, void __user *argp)
+{
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+
+	switch (ioctl) {
+	case KVM_DET_ENABLE: {
+		struct kvm_det_config cfg;
+
+		if (copy_from_user(&cfg, argp, sizeof(cfg)))
+			return -EFAULT;
+		return vmx_det_enable(vcpu, &cfg);
+	}
+	case KVM_DET_SET_TARGET: {
+		u64 target;
+
+		if (!vmx->det.counter)
+			return -EINVAL;
+		if (copy_from_user(&target, argp, sizeof(target)))
+			return -EFAULT;
+		return vmx_det_arm(vcpu, target);
+	}
+	case KVM_DET_GET_STATE: {
+		struct kvm_det_state st = {};
+
+		if (!vmx->det.counter)
+			return -EINVAL;
+		st.branches = vmx_det_branches(vmx);
+		st.tsc = vmx_det_tsc(vmx, st.branches);
+		st.target = vmx->det.target;
+		st.reached = vmx->det.reached;
+		st.rdtsc_exits = vmx->det.rdtsc_exits;
+		st.mtf_steps = vmx->det.mtf_steps;
+		st.overflows = vmx->det.overflows;
+		st.overshoots = vmx->det.overshoots;
+		st.skid_max = vmx->det.skid_max;
+		st.soft_exits = vmx->det.soft_exits;
+		st.fast_steps = vmx->det.fast_steps;
+		return copy_to_user(argp, &st, sizeof(st)) ? -EFAULT : 0;
+	}
+	case KVM_DET_SET_SOFT_TSC: {
+		u64 soft;
+
+		if (!vmx->det.counter)
+			return -EINVAL;
+		if (copy_from_user(&soft, argp, sizeof(soft)))
+			return -EFAULT;
+		vmx->det.soft_tsc = soft;
+		return 0;
+	}
+	case KVM_DET_ADD_TSC: {
+		u64 delta;
+
+		if (!vmx->det.counter)
+			return -EINVAL;
+		if (copy_from_user(&delta, argp, sizeof(delta)))
+			return -EFAULT;
+		vmx->det.tsc_base += delta;
+		return 0;
+	}
+	}
+	return -ENOTTY;
 }
 
