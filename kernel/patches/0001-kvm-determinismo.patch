+/*
+ * determinismo: XSAVE writes the processor's XINUSE as XSTATE_BV, and the host's own saves and
+ * restores of the guest's FPU (a preemption, kernel_fpu_begin() in an interrupt) may clear
+ * XINUSE bits of components in their initial state, at host-chosen moments: the guest saw
+ * XSTATE_BV 2 in one run and 3 in another, and timelines diverged (replays under host load:
+ * about one in two; with XSAVE hidden from the guest, none). The guest cannot change XINUSE
+ * while it does not run, so at each entry put back what host work cleared since the exit, by
+ * restoring those components' initial values as in use: the registers keep their values.
+ */
+#define DET_XINUSE_MASK (XFEATURE_MASK_FP | XFEATURE_MASK_SSE | XFEATURE_MASK_YMM | \
+			 XFEATURE_MASK_OPMASK | XFEATURE_MASK_ZMM_Hi256 | XFEATURE_MASK_Hi16_ZMM)
+#define DET_XBUF_SIZE 4096
+
+static u64 vmx_det_xinuse_read(void)
+{
+	return boot_cpu_has(X86_FEATURE_XGETBV1) ? xgetbv(1) & DET_XINUSE_MASK : 0;
+}
+
+static void vmx_det_xinuse_fix(struct vcpu_vmx *vmx)
+{
+	struct xregs_state *x = vmx->det.xbuf;
+	u64 lost;
+	u32 mxcsr;
+
+	if (!x)
+		return;
+	lost = vmx->det.xinuse & ~vmx_det_xinuse_read();
+	if (likely(!lost))
+		return;
+	/* Initial values (zeros, the x87 control word 037f) and the current MXCSR, in use. */
+	memset(x, 0, DET_XBUF_SIZE);
+	x->i387.cwd = 0x037f;
+	asm volatile("stmxcsr %0" : "=m"(mxcsr));
+	x->i387.mxcsr = mxcsr;
+	x->header.xfeatures = lost;
+	asm volatile("xrstor64 %0" : : "m"(*x), "a"((u32)lost), "d"((u32)(lost >> 32)) : "memory");
+	vmx->det.xinuse_fixes++;
+	if (vmx->det.xinuse & ~vmx_det_xinuse_read())
+		vmx->det.xinuse_unfixed++;
+}
+
+/*
+ * determinismo: no guest instruction runs between a vCPU's put and its next load, so its
+ * branch count, the guest's clock, must read the same at both: any difference is a drift.
+ */
+static void vmx_det_put_check(struct vcpu_vmx *vmx)
+{
+	if (!vmx->det.counter)
+		return;
+	vmx->det.put_branches = vmx_det_branches(vmx);
+	vmx->det.put_valid = true;
+}
+
+static void vmx_det_load_check(struct vcpu_vmx *vmx)
+{
+	u64 now;
+
+	if (!vmx->det.counter || !vmx->det.put_valid)
+		return;
+	vmx->det.put_valid = false;
+	now = vmx_det_branches(vmx);
+	if (now == vmx->det.put_branches)
+		return;
+	vmx->det.drifts++;
+	vmx->det.drift_last = (s64)(now - vmx->det.put_branches);
+}
