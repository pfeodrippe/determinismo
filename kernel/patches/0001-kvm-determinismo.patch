 #define KVM_PRE_FAULT_MEMORY	_IOWR(KVMIO, 0xd5, struct kvm_pre_fault_memory)
+
+/*
+ * determinismo: deterministic execution for single-vCPU VMs.
+ * Guest time is a function of retired guest branches: tsc = tsc_base + branches * tsc_per_branch.
+ */
+struct kvm_det_config {
+	__u64 event;		/* raw PMU event counting retired conditional branches */
+	__u64 tsc_base;
+	__u32 tsc_per_branch;
+	__u32 margin;		/* branches before a target where single-stepping starts */
+	__u64 flags;
+	__u64 reserved[4];
+};
+
+struct kvm_det_state {
+	__u64 branches;
+	__u64 tsc;
+	__u64 target;
+	__u64 reached;		/* branch count at the last KVM_EXIT_DET_TARGET */
+	__u64 rdtsc_exits;
+	__u64 mtf_steps;
+	__u64 overflows;
+	__u64 overshoots;
+	__u64 reserved[8];
+};
+
+#define KVM_DET_ENABLE		_IOW(KVMIO, 0xf0, struct kvm_det_config)
+#define KVM_DET_SET_TARGET	_IOW(KVMIO, 0xf1, __u64)	/* 0 cancels */
+#define KVM_DET_GET_STATE	_IOR(KVMIO, 0xf2, struct kvm_det_state)
+#define KVM_DET_ADD_TSC		_IOW(KVMIO, 0xf3, __u64)	/* e.g. idle time skipped */
 
