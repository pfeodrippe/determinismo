#!/bin/sh
# SPDX-License-Identifier: MIT
# PID 1 of the determinismo guest: minimal system setup, then the scenario named by
# det.scenario=<name> on the kernel command line, then reboot (which ends the VM run).
export PATH=/opt/determinismo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
ip link set lo up
hostname determinismo-guest
# The platform channel (/dev/determinismo) for SDKs and the runtime.
busybox insmod /opt/determinismo/modules/det_guest.ko
# Runs commands the platform pushes at a chosen moment (multiverse debugging); asleep otherwise.
det-agent &

scenario=default
for arg in $(cat /proc/cmdline); do
  case $arg in det.scenario=*) scenario=${arg#det.scenario=} ;; esac
done

echo "[guest] $(uname -r), clock $(date -u +%FT%TZ), scenario=$scenario"
/opt/determinismo/scenarios/$scenario/run
echo "[guest] scenario $scenario exited with status $?"
sync
busybox reboot -f
