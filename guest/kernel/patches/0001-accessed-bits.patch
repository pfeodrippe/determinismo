+/*
+ * determinismo: the processor may set the Accessed bit during a speculative page walk (Intel
+ * SDM), and speculation follows predictor and cache state, which the host perturbs: a page
+ * mapped old and never used read young in one run and old in another, and exit marked it
+ * accessed or not (about 150 branches: replays parted under host load). The guest never
+ * branches on it: LRU aging and khugepaged lose a hint; nothing depends on it for correctness.
+ */
 static inline int pte_young(pte_t pte)
 {
-	return pte_flags(pte) & _PAGE_ACCESSED;
+	return 0;
 }
 
