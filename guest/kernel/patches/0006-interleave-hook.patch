+/*
+ * determinismo: a module may steer the fair class's choices within a cgroup (det_guest.ko's
+ * `interleave` fault): which runnable entity runs next, whether a woken task preempts the
+ * running one, whether a tick preempts it. It returns an index below `choices`, or -1 to leave
+ * the choice to EEVDF. Unset, or -1, and nothing changes. Steering only: the module draws its
+ * choices from the platform's randomness, so a timeline replays with them.
+ */
+int (*det_sched_choose)(struct cgroup *cgroup, unsigned int choices) __read_mostly;
+EXPORT_SYMBOL_GPL(det_sched_choose);
+
+static int det_choose(struct cfs_rq *cfs_rq, unsigned int choices)
+{
+#ifdef CONFIG_FAIR_GROUP_SCHED
+	int (*choose)(struct cgroup *cgroup, unsigned int choices) = READ_ONCE(det_sched_choose);
+
+	if (choose && choices >= 2)
+		return choose(cfs_rq->tg->css.cgroup, choices);
+#endif
+	return -1;
+}
+
+/* The runnable entity at `index`: the current one first (when runnable), then the tree's. */
+static struct sched_entity *det_entity_at(struct cfs_rq *cfs_rq, unsigned int index)
+{
+	struct sched_entity *curr = cfs_rq->curr;
+	struct rb_node *node;
+
+	if (curr && curr->on_rq) {
+		if (!index)
+			return curr;
+		index--;
+	}
+	for (node = rb_first_cached(&cfs_rq->tasks_timeline); node && index; node = rb_next(node))
+		index--;
+	return node ? __node_2_se(node) : NULL;
+}
 
