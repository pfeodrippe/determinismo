#!/bin/sh
# SPDX-License-Identifier: MIT
# Initializes and starts Postgres, runs a randomized SQL workload, prints a result digest.
set -e
pgbin=$(ls -d /usr/lib/postgresql/*/bin | tail -1)
mkdir -p /tmp/pg && chown postgres:postgres /tmp/pg
su postgres -s /bin/sh -c "$pgbin/initdb -D /tmp/pg -A trust --no-sync -U postgres" >/tmp/initdb.log
su postgres -s /bin/sh -c "$pgbin/pg_ctl -D /tmp/pg -l /tmp/pg.log -w start \
  -o '-k /tmp -c listen_addresses=127.0.0.1 -c fsync=off -c synchronous_commit=off'" >/dev/null
psql="psql -X -q -h 127.0.0.1 -U postgres -At"
$psql -c "create table accounts(id int primary key, balance bigint not null)"
$psql -c "insert into accounts select g, 1000 from generate_series(1, 100) g"
# Random transfers; the total must stay 100000 (an invariant the workload checks).
$psql -c "do \$\$ declare a int; b int; amt int; begin
  for i in 1..2000 loop
    a := 1 + floor(random() * 100); b := 1 + floor(random() * 100); amt := floor(random() * 50);
    update accounts set balance = balance - amt where id = a;
    update accounts set balance = balance + amt where id = b;
  end loop; end \$\$"
total=$($psql -c "select sum(balance) from accounts")
digest=$($psql -c "select md5(string_agg(id || ':' || balance, ',' order by id)) from accounts")
echo "[postgres] total=$total (invariant 100000: $([ "$total" = 100000 ] && echo ok || echo VIOLATED)) digest=$digest now=$($psql -c 'select now()')"
su postgres -s /bin/sh -c "$pgbin/pg_ctl -D /tmp/pg -m immediate stop" >/dev/null
