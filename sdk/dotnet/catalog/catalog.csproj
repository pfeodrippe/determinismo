<Project Sdk="Microsoft.NET.Sdk">
  <!-- determinismo catalog generator: run it with the project directory as its argument (README in Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>determinismo-catalog</AssemblyName>
  </PropertyGroup>
</Project>
